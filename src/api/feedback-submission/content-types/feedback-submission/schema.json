{
  "kind": "collectionType",
  "collectionName": "feedback_submissions",
  "info": {
    "singularName": "feedback-submission",
    "pluralName": "feedback-submissions",
    "displayName": "Feedback Submission",
    "description": "Stakeholder feedback and grievance submissions"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "role": {
      "type": "enumeration",
      "enum": [
        "Student",
        "Alumni",
        "Parent",
        "Employer",
        "Faculty"
      ]
    },
    "email": {
      "type": "email"
    },
    "phone": {
      "type": "string"
    },
    "message": {
      "type": "text",
      "required": true
    },
    "rating": {
      "type": "integer",
      "min": 1,
      "max": 5
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "New",
        "Reviewed",
        "Archived"
      ],
      "default": "New"
    }
  }
}
