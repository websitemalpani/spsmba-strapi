{
  "kind": "collectionType",
  "collectionName": "programs",
  "info": {
    "singularName": "program",
    "pluralName": "programs",
    "displayName": "Program",
    "description": "Academic programmes offered"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "level": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "intake": {
      "type": "integer"
    },
    "overview": {
      "type": "richtext"
    },
    "eligibility": {
      "type": "richtext"
    },
    "specializations": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::specialization.specialization",
      "inversedBy": "programs"
    },
    "curriculum": {
      "type": "json"
    },
    "careerOpportunities": {
      "type": "json"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "documents": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "files",
        "images"
      ]
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  }
}
