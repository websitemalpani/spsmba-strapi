{
  "kind": "collectionType",
  "collectionName": "committees",
  "info": {
    "singularName": "committee",
    "pluralName": "committees",
    "displayName": "Committee",
    "description": "Statutory and administrative committees"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "academicYear": {
      "type": "string"
    },
    "description": {
      "type": "richtext"
    },
    "members": {
      "type": "component",
      "repeatable": true,
      "component": "committee.member"
    },
    "documents": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "files"
      ]
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  }
}
