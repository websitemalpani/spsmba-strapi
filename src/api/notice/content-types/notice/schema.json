{
  "kind": "collectionType",
  "collectionName": "notices",
  "info": {
    "singularName": "notice",
    "pluralName": "notices",
    "displayName": "Notice",
    "description": "Notices and circulars"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Admissions",
        "Fees",
        "IQAC",
        "Academics",
        "Committee",
        "Examination",
        "General"
      ]
    },
    "description": {
      "type": "text"
    },
    "date": {
      "type": "date"
    },
    "academicYear": {
      "type": "string"
    },
    "pdf": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    },
    "externalUrl": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "published": {
      "type": "boolean",
      "default": true
    },
    "expiryDate": {
      "type": "date"
    }
  }
}
